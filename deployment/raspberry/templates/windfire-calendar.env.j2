# Managed by Ansible (templates/windfire-calendar.env.j2) - local changes are overwritten on deploy
# Non-secret configuration only: KEYCLOAK_CLIENT_SECRET is loaded by systemd from /etc/credstore.encrypted

# Application name
APP_NAME={{ app_name }}

# Server Configuration
API_HOST=0.0.0.0
API_PORT={{ api_port }}
API_PORT_SECURE={{ api_port_secure }}

# SSL Configuration
SSL_KEYFILE=./ssl/{{ windfire_server_key }}
SSL_CERTFILE=./ssl/{{ windfire_server_certificate }}

# HTTPS Configuration
ENFORCE_HTTPS=true
ALLOWED_HOSTS={{ allowed_hosts }}

# Keycloak Configuration
KEYCLOAK_PROD_HOST={{ keycloak_server_host }}
KEYCLOAK_PROD_PORT={{ keycloak_server_port }}
KEYCLOAK_SERVICE={{ keycloak_service }}

# Logging Configuration
DEFAULT_LOG_LEVEL={{ log_level }}
DEFAULT_LOG_FILE={{ log_file }}
DEFAULT_LOG_BACKUP_COUNT={{ log_backup_count }}
DEFAULT_LOG_ROTATION_WHEN={{ log_rotation_when }}
DEFAULT_LOG_ROTATION_INTERVAL={{ log_rotation_interval }}

# Google OAuth Configuration (relative paths are resolved against the app directory)
GOOGLE_CREDENTIALS_FILE=./credentials.json
GOOGLE_TOKEN_FILE=./token.json
