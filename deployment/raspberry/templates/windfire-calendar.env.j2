# Managed by Ansible (templates/windfire-calendar.env.j2) - local changes are overwritten on deploy
# Non-secret configuration only: the Google OAuth files are loaded by systemd from /etc/credstore.encrypted

# Application name
APP_NAME={{ app_name }}

# Server Configuration
API_HOST=0.0.0.0
API_PORT={{ api_port }}
API_PORT_SECURE={{ api_port_secure }}

# SSL Configuration
SSL_KEYFILE=./ssl/{{ windfire_server_key }}
SSL_CERTFILE=./ssl/{{ windfire_server_certificate }}

# HTTPS Configuration
ENFORCE_HTTPS=true
ALLOWED_HOSTS={{ allowed_hosts }}

# Windfire Security Configuration
WINDFIRE_SECURITY_PROD_HOST={{ windfire_security_host }}
WINDFIRE_SECURITY_PROD_PORT={{ windfire_security_port }}
WINDFIRE_SECURITY_SERVICE={{ windfire_security_service }}

# Logging Configuration
DEFAULT_LOG_LEVEL={{ log_level }}
DEFAULT_LOG_FILE={{ log_file }}
DEFAULT_LOG_BACKUP_COUNT={{ log_backup_count }}
DEFAULT_LOG_ROTATION_WHEN={{ log_rotation_when }}
DEFAULT_LOG_ROTATION_INTERVAL={{ log_rotation_interval }}

# Google OAuth Configuration
# GOOGLE_CREDENTIALS_FILE and GOOGLE_TOKEN_FILE are set by the systemd unit (windfire-calendar.service.j2):
# they point to the files systemd decrypts from /etc/credstore.encrypted into the read-only credentials directory
# Headless server: never start the browser OAuth flow, fail fast if the token is expired or revoked
GOOGLE_INTERACTIVE_AUTH=false
