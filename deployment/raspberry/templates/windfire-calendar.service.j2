[Unit]
Description=Windfire Calendar Service API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ user }}
WorkingDirectory={{ remote_windfire_calendar_dir }}/app
Environment=ENVIRONMENT=prod
Environment=WINDFIRE_SECURITY_ENVIRONMENT=prod
Environment=WINDFIRE_SECURITY_HOST={{ windfire_security_host }}
Environment=WINDFIRE_SECURITY_PORT={{ windfire_security_port }}
Environment=VERIFY_SSL_CERTS=true
Environment=ROOT_CA_PATH={{ remote_truststore_dir }}/{{ windfire_ca_root_certificate }}
Environment=LOG_LEVEL={{ log_level }}
LoadCredentialEncrypted={{ service_name }}-google-client:/etc/credstore.encrypted/{{ service_name }}-google-client
LoadCredentialEncrypted={{ service_name }}-google-token:/etc/credstore.encrypted/{{ service_name }}-google-token
# %d is the credentials directory ($CREDENTIALS_DIRECTORY) of this unit: read-only, so the app never writes the token back
Environment=GOOGLE_CREDENTIALS_FILE=%d/{{ service_name }}-google-client
Environment=GOOGLE_TOKEN_FILE=%d/{{ service_name }}-google-token
ExecStart={{ venv_path }}/bin/python calendarApiServer.py
Restart=on-failure
RestartSec=5
StandardOutput=append:{{ remote_windfire_calendar_dir }}/app/logs/{{ service_name }}.log
StandardError=append:{{ remote_windfire_calendar_dir }}/app/logs/{{ service_name }}.log
# Sandbox: the whole filesystem is read-only to the service (ProtectSystem=strict, ProtectHome=read-only)
# except ReadWritePaths, the logs directory the app writes to.
# The app directory stays read-only: the Google token is read from the read-only credentials directory (%d)
# and refreshed in memory only, never written back.
# No MemoryDenyWriteExecute: it breaks JIT runtimes (JVM, Node/V8) and some Python wheels.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ remote_windfire_calendar_dir }}/app/logs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
