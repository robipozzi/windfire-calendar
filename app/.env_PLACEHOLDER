# Application name
APP_NAME=Windfire Calendar Service API

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PORT_SECURE=8443

# SSL Configuration (comment out for HTTP)
SSL_KEYFILE=./ssl/<PUT_KEY_FILE_NAME_HERE>.key
SSL_CERTFILE=./ssl/<PUT_CERT_FILE_NAME_HERE>.crt

# HTTPS Configuration
ENFORCE_HTTPS=true  # Set to True/true to enable HTTPS enforcement, Set to False/false to disable HTTPS enforcement (dev only)
ALLOWED_HOSTS=localhost,yourdomain.com,api.yourdomain.com
# Optional: comma-separated origins (scheme://host[:port]) of browser apps allowed to call the API, e.g. https://app.yourdomain.com
# Leave empty to disable cross-origin requests
CORS_ORIGINS=

# API documentation: true serves Swagger UI (/docs), ReDoc (/redoc), /openapi.json and redirects / to /docs
# Set to false (or leave unset) in production
ENABLE_API_DOCS=true

# Windfire Security Configuration
# Windfire Security auth server environments - selected at startup, default prod
# The ports are the windfire-security port (8444), NOT the port of Keycloak itself (8443)
WINDFIRE_SECURITY_DEV_HOST=<PUT_WINDFIRE_SECURITY_DEV_HOST_HERE>
WINDFIRE_SECURITY_DEV_PORT=<PUT_WINDFIRE_SECURITY_DEV_PORT_HERE>
WINDFIRE_SECURITY_TEST_HOST=<PUT_WINDFIRE_SECURITY_TEST_HOST_HERE>
WINDFIRE_SECURITY_TEST_PORT=<PUT_WINDFIRE_SECURITY_TEST_PORT_HERE>
WINDFIRE_SECURITY_PROD_HOST=<PUT_WINDFIRE_SECURITY_PROD_HOST_HERE>
WINDFIRE_SECURITY_PROD_PORT=<PUT_WINDFIRE_SECURITY_PROD_PORT_HERE>
WINDFIRE_SECURITY_SERVICE=<PUT_WINDFIRE_SECURITY_SERVICE_HERE>

# Logging Configuration
DEFAULT_LOG_LEVEL=DEBUG # Valid Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
DEFAULT_LOG_FILE=<PUT_LOG_FILE_PATH_HERE>
DEFAULT_LOG_BACKUP_COUNT=7
DEFAULT_LOG_ROTATION_WHEN=midnight
DEFAULT_LOG_ROTATION_INTERVAL=1

# Google OAuth Configuration (relative paths are resolved against the app directory)
GOOGLE_CREDENTIALS_FILE=./credentials.json
GOOGLE_TOKEN_FILE=./token.json
# Set to false on headless servers so an expired or revoked token fails fast instead of starting the browser OAuth flow
GOOGLE_INTERACTIVE_AUTH=true
